{
    "compilerOptions": {
        "composite": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "skipLibCheck": true,
        "allowJs": true,
        "noEmit": true
    },
    "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.json"]
}
